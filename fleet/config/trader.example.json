{
  "_": "Sablon pentru un TRADER: agentul care roteste vault-ul unui Financial NFA dupa semnalele private din financial-nfa. Copiaza in trader.json, pune adresele reale dupa deploy si monteaza creierul in ./brain. Un agent = UN NFT: pentru al doilea NFT faci alta copie, cu alt tokenId, alta cheie in env si alte porturi.",
  "watchtower": false,
  "agent": {
    "kind": "trader",
    "id": 1,
    "name": "TRADER #0001",
    "collection": null,
    "wallet": null,
    "owner": null
  },
  "network": {
    "name": "robinhood",
    "chainId": 4663,
    "rpc": ["https://rpc.mainnet.chain.robinhood.com"],
    "explorer": "https://robinhoodchain.blockscout.com",
    "nativeSymbol": "ETH",
    "multicall3": "0xcA11bde05977b3631167028862bE2a173976CA11",
    "blockTimeMs": 2000
  },
  "target": {
    "address": "0x0000000000000000000000000000000000000000",
    "_": "colectia AgentNFT; pe zero, agentul asteapta cuminte",
    "errorSignatures": ["error NotAgent()", "error IsPaused()", "error SlippageTooHigh()", "error Cooldown()"],
    "deployBlock": 0
  },
  "job": {
    "tokenId": 1,
    "registry": "0x0000000000000000000000000000000000000000",
    "brain": { "dir": "./brain" },
    "tokens": {
      "USDG": { "address": "0x0000000000000000000000000000000000000000", "decimals": 6, "feed": null },
      "NVDA": { "address": "0x0000000000000000000000000000000000000000", "decimals": 18, "feed": "0x0000000000000000000000000000000000000000" }
    },
    "eth": { "feed": null, "usd8": "0" },
    "history": { "range": "1y", "cacheDir": "./data/prices-live" }
  },
  "policy": {
    "mode": "campaign",
    "requireMeasuredCost": true,
    "maxCostPerJobWei": "50000000000000000",
    "dailySpendBudgetWei": "150000000000000000",
    "cooldownSec": 3600,
    "maxJobsPerRun": 1,
    "gasCapPerCall": "2500000",
    "dailyGasBudgetWei": "20000000000000000"
  },
  "execution": {
    "dryRun": true,
    "privateKey": "env:TRADER_KEY",
    "killSwitchFile": "./data/STOP-trader"
  },
  "runner": {
    "mode": "interval",
    "intervalSec": 600,
    "jitterSec": 30,
    "staleAfterSec": 1800,
    "watchdogSec": 3600
  },
  "api": { "enabled": true, "host": "127.0.0.1", "port": 8804 },
  "console": { "enabled": false, "host": "127.0.0.1", "port": 8805, "token": "env:CONSOLE_TOKEN" },
  "storage": { "file": "./data/trader.db" }
}
