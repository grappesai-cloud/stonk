{
  "_": "MINER. Inlocuieste adresa marcata TODO si ruleaza `fleet doctor -c config/miner.json`. Intrebarea care decide daca agentul exista: inchiderea rundei merge apelata de un strain, sau e a oracolului? Diagnosticul raspunde prin simulare, nu din textul erorii.",

  "watchtower": true,

  "agent": {
    "kind": "miner",
    "id": 0,
    "name": "MINER #0000",
    "collection": null,
    "wallet": null,
    "owner": null
  },

  "network": {
    "name": "robinhood",
    "chainId": 4663,
    "rpc": ["https://rpc.mainnet.chain.robinhood.com"],
    "explorer": "https://robinhoodchain.blockscout.com",
    "nativeSymbol": "ETH",
    "multicall3": "0xcA11bde05977b3631167028862bE2a173976CA11",
    "blockTimeMs": 2000
  },

  "target": {
    "address": "0x0000000000000000000000000000000000000000",
    "_TODO": "adresa contractului de runde (Broker Box)",
    "errorSignatures": [],
    "deployBlock": 0
  },

  "job": {
    "discovery": {
      "_": "'list' cand contractul da direct lista, 'range' cand are un cursor, 'logs' cand nu expune nimic si trebuie citite evenimentele.",
      "mode": "list",
      "call": { "signature": "function pendingRounds() view returns (uint256[])", "args": [], "field": null }
    },
    "state": {
      "call": { "signature": "function roundOf(uint256 id) view returns (uint8 status, uint256 bounty, uint256 pot)", "args": ["$id"], "field": null },
      "readyWhen": { "mode": "equals", "field": "status", "value": 2 },
      "stakeField": "pot"
    },
    "reward": { "mode": "field", "field": "bounty" },
    "action": { "signature": "function settle(uint256 id)", "args": ["$id"], "field": null },
    "authority": {
      "_": "Cine are voie, daca functia e rezervata. Gol = incercam owner(). La un contract VRF, pune aici citirea coordonatorului.",
      "address": null,
      "call": null
    },
    "readChunk": 200
  },

  "policy": {
    "mode": "profit",
    "profitMultiple": 1.5,
    "minRewardWei": "0",
    "minStakeWei": "0",
    "requireMeasuredReward": true,
    "cooldownSec": 300,
    "maxJobsPerRun": 25,
    "batchSize": 1,
    "gasCapPerCall": "400000",
    "maxGasPriceWei": null,
    "dailyGasBudgetWei": null,
    "denyKeys": []
  },

  "execution": {
    "dryRun": true,
    "privateKey": "env:MINER_KEY",
    "beneficiary": null,
    "confirmations": 1,
    "maxFeePerGasWei": null,
    "maxPriorityFeePerGasWei": null,
    "killSwitchFile": "./data/STOP-miner",
    "maxConsecutiveFailures": 5
  },

  "runner": {
    "mode": "interval",
    "intervalSec": 60,
    "jitterSec": 10,
    "pollMs": 1000,
    "staleAfterSec": 300,
    "watchdogSec": 900
  },

  "alerts": {
    "telegram": { "enabled": false, "token": "env:TELEGRAM_TOKEN", "channel": null, "digestHour": 9, "gasLowWei": "2000000000000000" },
    "heartbeat": { "url": "env:HEARTBEAT_URL", "failUrl": null, "timeoutMs": 5000 }
  },

  "api": { "enabled": true, "host": "127.0.0.1", "port": 8792, "cors": ["*"], "rateLimitPerMinute": 120 },
  "console": { "enabled": false, "host": "127.0.0.1", "port": 8793, "token": "env:CONSOLE_TOKEN" },
  "storage": {
    "file": "./data/miner.db",
    "backup": { "enabled": true, "dir": "./data/backups", "everyHours": 6, "keep": 28 }
  }
}
