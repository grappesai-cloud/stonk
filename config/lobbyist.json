{
  "_": "LOBBYIST. Voteaza cu o pozitie care EXISTA DEJA si isi incaseaza partea. NU blocheaza jetoane si nu prelungeste blocari: aia ramane o decizie de om, cu bani care nu se mai pot lua inapoi luni de zile.",

  "watchtower": true,

  "agent": { "kind": "lobbyist", "id": 0, "name": "LOBBYIST #0000", "collection": null, "wallet": null, "owner": null },

  "network": {
    "name": "robinhood",
    "chainId": 4663,
    "rpc": ["https://rpc.mainnet.chain.robinhood.com"],
    "explorer": "https://explorer.mainnet.chain.robinhood.com",
    "nativeSymbol": "ETH",
    "multicall3": "0xcA11bde05977b3631167028862bE2a173976CA11",
    "blockTimeMs": 2000
  },

  "target": {
    "address": "0x0000000000000000000000000000000000000000",
    "_TODO": "adresa contractului de votare",
    "errorSignatures": [],
    "deployBlock": 0
  },

  "job": {
    "_position": "Blocarea cu care votam. Agentul nu o creeaza; daca nu exista, sta si spune ca sta.",
    "position": {
      "tokenId": null,
      "power": { "signature": "function balanceOfNFT(uint256 id) view returns (uint256)", "args": ["$id"], "field": null },
      "owner": null
    },
    "_epoch": "Fereastra in care se voteaza. Cine voteaza cand ii vine lui nu voteaza niciodata: dupa inchidere contractul refuza.",
    "epoch": {
      "end": { "signature": "function epochEnd() view returns (uint256)", "args": [], "field": null },
      "voteBeforeSec": 3600,
      "stopBeforeSec": 60
    },
    "gauges": { "mode": "call", "call": { "signature": "function gauges() view returns (address[])", "args": [], "field": null } },
    "bribes": { "signature": "function bribesOf(address gauge) view returns (uint256)", "args": ["$gauge"], "field": null },
    "votes": { "signature": "function votesOf(address gauge) view returns (uint256)", "args": ["$gauge"], "field": null },
    "_weights": "'bps' = greutati care aduna 10000, cum cer multe contracte. 'power' = puterea impartita. topN = pe cate gauge-uri se imparte.",
    "weights": { "mode": "bps", "topN": 1 },
    "vote": {
      "signature": "function vote(uint256 tokenId, address[] gauges, uint256[] weights)",
      "args": ["$id", "$gauges", "$weights"],
      "field": null
    },
    "_claim": "Fara blocul asta agentul voteaza si nu incaseaza niciodata: ce castiga ramane pe contract.",
    "claim": {
      "claimable": { "signature": "function claimable(uint256 id) view returns (uint256)", "args": ["$id"], "field": null },
      "action": { "signature": "function claim(uint256 id)", "args": ["$id"], "field": null }
    }
  },

  "policy": {
    "mode": "profit",
    "profitMultiple": 1.5,
    "minRewardWei": "0",
    "minStakeWei": "0",
    "requireMeasuredReward": true,
    "requireMeasuredCost": true,
    "maxCostPerJobWei": null,
    "dailySpendBudgetWei": null,
    "cooldownSec": 0,
    "maxJobsPerRun": 4,
    "batchSize": 1,
    "gasCapPerCall": "800000",
    "maxGasPriceWei": null,
    "dailyGasBudgetWei": null,
    "denyKeys": []
  },

  "execution": {
    "dryRun": true,
    "privateKey": "env:LOBBYIST_KEY",
    "beneficiary": null,
    "confirmations": 1,
    "maxFeePerGasWei": null,
    "maxPriorityFeePerGasWei": null,
    "killSwitchFile": "./data/STOP-lobbyist",
    "maxConsecutiveFailures": 5
  },

  "_runner": "Epoca se inchide o data pe saptamana, dar fereastra de vot e scurta. Un interval de cateva minute e destul si nu bate RPC-ul degeaba.",
  "runner": { "mode": "interval", "intervalSec": 300, "jitterSec": 30, "pollMs": 1000, "staleAfterSec": 1200, "watchdogSec": 2400 },

  "alerts": {
    "telegram": { "enabled": false, "token": "env:TELEGRAM_TOKEN", "channel": null, "digestHour": 9, "gasLowWei": "2000000000000000" },
    "heartbeat": { "url": "env:HEARTBEAT_URL", "failUrl": null, "timeoutMs": 5000 }
  },

  "api": { "enabled": true, "host": "127.0.0.1", "port": 8796, "cors": ["*"], "rateLimitPerMinute": 120 },
  "console": { "enabled": false, "host": "127.0.0.1", "port": 8797, "token": "env:CONSOLE_TOKEN" },
  "storage": { "file": "./data/lobbyist.db", "backup": { "enabled": true, "dir": "./data/backups", "everyHours": 6, "keep": 28 } }
}
