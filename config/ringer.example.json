{
  "_": "RINGER. Inlocuieste adresa marcata TODO cu contractul real de la StonkBrokers si ruleaza mai intai `fleet doctor -c config/ringer.json`. Semnaturile NU se scriu de mana: `fleet init <adresa>` citeste ABI-ul verificat si propune candidati.",

  "_watchtower": "Pornit inseamna: masoara cursa, nu cheltui nimic. E modul cu care se incepe, fiindca raspunde la singura intrebare care conteaza inainte sa arzi gaz: butonul asta e liber sau il apasa deja altcineva mai rapid?",
  "watchtower": true,

  "agent": {
    "kind": "ringer",
    "id": 0,
    "name": "RINGER #0000",
    "collection": null,
    "wallet": null,
    "owner": null
  },

  "network": {
    "name": "robinhood",
    "chainId": 4663,
    "rpc": ["https://rpc.mainnet.chain.robinhood.com"],
    "explorer": "https://robinhoodchain.blockscout.com",
    "nativeSymbol": "ETH",
    "multicall3": "0xcA11bde05977b3631167028862bE2a173976CA11",
    "blockTimeMs": 2000
  },

  "target": {
    "address": "0x0000000000000000000000000000000000000000",
    "_TODO": "adresa contractului cu Clock In",
    "errorSignatures": [],
    "deployBlock": 0
  },

  "job": {
    "_": "Toate semnaturile de aici sunt SABLOANE. Se inlocuiesc cu cele adevarate dupa `fleet init`.",
    "slots": null,
    "pot": { "signature": "function pot() view returns (uint256)", "args": [], "field": null },
    "ready": {
      "mode": "call-bool",
      "call": { "signature": "function canClockIn() view returns (bool)", "args": [], "field": null },
      "expect": true
    },
    "reward": {
      "_": "'call' e singurul mod in care castigul e MASURAT. 'const' e o presupunere si in modul profit va fi refuzata.",
      "mode": "call",
      "call": { "signature": "function clockInTip() view returns (uint256)", "args": [], "field": null }
    },
    "action": { "signature": "function clockIn()", "args": [], "field": null },
    "event": {
      "_": "Fara asta nu exista caiet de curse: vezi doar ca oala s-a golit, nu si cine a apucat-o.",
      "signature": "event ClockIn(address indexed caller, uint256 pot, uint256 tip)",
      "callerField": "caller",
      "rewardField": "tip",
      "slotField": null
    },
    "race": {
      "priorityBumpBps": 2000,
      "maxPriorityFeeWei": null,
      "staleBlocks": 3
    }
  },

  "policy": {
    "mode": "profit",
    "profitMultiple": 1.5,
    "minRewardWei": "0",
    "minStakeWei": "0",
    "requireMeasuredReward": true,
    "cooldownSec": 0,
    "maxJobsPerRun": 4,
    "batchSize": 1,
    "gasCapPerCall": "300000",
    "maxGasPriceWei": null,
    "dailyGasBudgetWei": null,
    "denyKeys": []
  },

  "execution": {
    "dryRun": true,
    "privateKey": "env:RINGER_KEY",
    "beneficiary": null,
    "confirmations": 1,
    "maxFeePerGasWei": null,
    "maxPriorityFeePerGasWei": null,
    "killSwitchFile": "./data/STOP-ringer",
    "maxConsecutiveFailures": 5
  },

  "runner": {
    "_": "'block' e obligatoriu la Ringer: cine se uita din 5 in 5 minute nu apasa niciodata butonul.",
    "mode": "block",
    "intervalSec": 60,
    "jitterSec": 0,
    "pollMs": 1000,
    "staleAfterSec": 300,
    "watchdogSec": 900
  },

  "alerts": {
    "telegram": { "enabled": false, "token": "env:TELEGRAM_TOKEN", "channel": null, "digestHour": 9, "gasLowWei": "2000000000000000" },
    "heartbeat": { "url": "env:HEARTBEAT_URL", "failUrl": null, "timeoutMs": 5000 }
  },

  "api": { "enabled": true, "host": "127.0.0.1", "port": 8790, "cors": ["*"], "rateLimitPerMinute": 120 },
  "console": { "enabled": false, "host": "127.0.0.1", "port": 8791, "token": "env:CONSOLE_TOKEN" },
  "storage": {
    "file": "./data/ringer.db",
    "backup": { "enabled": true, "dir": "./data/backups", "everyHours": 6, "keep": 28 }
  }
}
