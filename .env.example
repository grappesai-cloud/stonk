# Cheia operatorului. NU se pune in fisierul de configurare si NU sta pe laptop.
# Wallet nou, facut pe server, cu gaz cat pentru cateva zile, fara legatura cu
# nimic altceva. Daca e compromisa, se pierde doar gazul de pe el.
COURIER_KEY=0x

# Jetonul botului de Telegram, de la @BotFather.
TELEGRAM_TOKEN=

# info | debug | warn | error
LOG_LEVEL=info
# json in productie, ca sa poata fi citit de masini
LOG_FORMAT=json

# Jetonul consolei de operator. Orice sir lung si aleator.
# Consola sta pe 127.0.0.1, jetonul e a doua incuietoare, nu prima.
CONSOLE_TOKEN=

# Ciocanitorul din afara. Faci un check pe healthchecks.io (sau Uptime Kuma,
# BetterStack) si pui aici URL-ul lui de ping. Botul il loveste dupa fiecare
# rulare reusita; daca nu mai loveste, primesti tu alerta, nu el.
# Fara asta, pulsul e oprit si nimeni nu afla ca botul a murit.
HEARTBEAT_URL=
