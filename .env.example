# Cheile agentilor. NU se pun in fisierele de configurare si NU stau pe laptop.
# Portofel NOU, facut pe server, cu gaz cat pentru cateva zile.
#
# ATENTIE, lucru masurat pe 4663: o adresa cu delegare EIP-7702 (adica una
# facuta prin aplicatie, nu una goala) primeste plati prin `call{value}` fara
# ca banii sa ramana acolo. Tranzactia iese reusita si castigul nu e nicaieri.
# `fleet doctor` verifica asta si o spune. Cheia trebuie sa fie a unei adrese
# care nu a fost niciodata delegata.
RINGER_KEY=
COURIER_KEY=
MINER_KEY=
# Stocker CHELTUIE, nu doar arde gaz. Cheia lui tine bani de marfa, deci pe ea
# se pun cele mai mici sume cu care meseria are sens, si franele din
# config/stocker.json (maxCostPerJobWei, dailySpendBudgetWei) inainte de toate.
STOCKER_KEY=
# Lobbyist voteaza cu o blocare care exista deja. Cheia lui trebuie sa fie a
# adresei care DETINE pozitia, altfel contractul o respinge, si asa si trebuie.
LOBBYIST_KEY=

# Jetonul botului de Telegram, de la @BotFather. Botul e DOAR citire.
TELEGRAM_TOKEN=

# info | debug | warn | error
LOG_LEVEL=info
# json in productie, ca sa poata fi citit de masini
LOG_FORMAT=json

# Jetonul consolei de operator. Orice sir lung si aleator, generat PE SERVER:
#   openssl rand -hex 32
# Consola sta pe loopback, jetonul e a doua incuietoare, nu prima.
CONSOLE_TOKEN=

# Ciocanitorul din afara. Un proces mort nu poate anunta ca a murit, deci
# raportarea se face invers: cine nu mai primeste puls, tipa. Capcana: un
# monitor pus pe ACELASI server nu vede serverul cazut.
HEARTBEAT_URL=
