"""Materiale de corp: in loc de o culoare plata, picteaza o textura in masca costumului."""
import math
from .core import shade

MATS = []


def mat(name, weight):
    def deco(fn):
        MATS.append((name, weight, fn))
        return fn
    return deco


def _n(x, y, k=1):
    return (math.sin(x * 12.9898 * k + y * 78.233) * 43758.5453) % 1.0


@mat('Matrix Code', 3)
def _matrix(x, y, s):
    if _n(x, y * 3) > 0.72:
        return (110, 250, 140) if _n(x, y) > 0.5 else (36, 176, 72)
    return (10, 34, 16) if s == 2 else (6, 22, 11)


@mat('Circuit', 3)
def _circ(x, y, s):
    if y % 5 == 2 or x % 7 == 3:
        return (72, 216, 240)
    if _n(x, y) > 0.93:
        return (250, 220, 96)
    return (18, 30, 48) if s == 2 else (11, 20, 34)


@mat('Cosmic', 2)
def _cos(x, y, s):
    v = _n(x, y)
    if v > 0.95:
        return (250, 250, 255)
    if v > 0.88:
        return (176, 150, 250)
    base = (58, 26, 104) if s == 2 else (38, 16, 74)
    return shade(base, 1.0 + 0.35 * math.sin(x * 0.4 + y * 0.25))


@mat('Camo', 4)
def _camo(x, y, s):
    v = math.sin(x * 0.7 + y * 0.4) + math.sin(x * 0.3 - y * 0.9)
    c = (74, 96, 46) if v > 0.6 else ((44, 60, 32) if v > -0.5 else (108, 116, 70))
    return c if s == 2 else shade(c, 0.7)


@mat('Molten', 2)
def _lava(x, y, s):
    v = math.sin(x * 0.9 + y * 0.7) + math.sin(y * 1.3)
    if v > 1.1:
        return (252, 216, 96)
    if v > 0.4:
        return (244, 108, 22)
    return (44, 26, 24) if s == 2 else (28, 16, 16)


@mat('Frozen', 3)
def _ice(x, y, s):
    if _n(x, y * 2) > 0.9:
        return (238, 250, 255)
    base = (146, 206, 236) if s == 2 else (104, 164, 204)
    return shade(base, 1.0 + 0.12 * math.sin(y * 0.8))


@mat('Solid Gold', 2)
def _gold(x, y, s):
    t = (y - 16) / 26.0
    base = (252, 214, 96) if s == 2 else (196, 148, 34)
    if (x + y) % 9 == 0:
        return (255, 248, 208)
    return shade(base, 1.15 - 0.4 * t)


@mat('Overgrown', 3)
def _moss(x, y, s):
    v = _n(x * 2, y)
    if v > 0.78:
        return (86, 154, 62)
    if v > 0.64:
        return (54, 108, 44)
    return (128, 128, 118) if s == 2 else (88, 88, 82)


@mat('Glitched', 2)
def _glitch(x, y, s):
    band = int(_n(0, y) * 6)
    cols = [(250, 40, 130), (60, 250, 210), (250, 220, 40), (140, 60, 250),
            (40, 250, 90), (250, 250, 250)]
    if _n(x, y) > 0.55:
        return cols[band % 6]
    return (20, 20, 26) if s == 2 else (12, 12, 16)


@mat('Chrome', 3)
def _chr(x, y, s):
    t = abs((x - 24) / 14.0)
    base = 210 - int(96 * t)
    v = (base, base + 6, base + 14)
    return v if s == 2 else shade(v, 0.72)


@mat('Rusted', 3)
def _rust(x, y, s):
    v = _n(x * 1.5, y)
    if v > 0.8:
        return (188, 96, 40)
    if v > 0.6:
        return (128, 62, 28)
    return (156, 132, 108) if s == 2 else (110, 92, 74)


@mat('Marble', 2)
def _mar(x, y, s):
    v = math.sin(x * 0.5 + y * 0.9) + math.sin(y * 0.3)
    if v > 1.2:
        return (140, 148, 162)
    base = (238, 238, 234) if s == 2 else (198, 198, 196)
    return base


@mat('Neon Wire', 3)
def _nw(x, y, s):
    if (x + y) % 6 == 0 or (x - y) % 7 == 0:
        return (250, 60, 190)
    if (x * 2 + y) % 9 == 0:
        return (60, 240, 240)
    return (22, 14, 34) if s == 2 else (14, 8, 24)


@mat('Denim', 3)
def _den(x, y, s):
    if (x + y * 2) % 5 == 0:
        return (86, 118, 176)
    base = (62, 92, 150) if s == 2 else (44, 68, 116)
    return base


@mat('Toxic Slime', 2)
def _slime(x, y, s):
    v = math.sin(x * 0.8 + y * 1.1)
    if v > 0.75:
        return (196, 250, 96)
    base = (108, 200, 52) if s == 2 else (68, 148, 34)
    return base
